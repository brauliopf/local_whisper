OPENAI_API_KEY=replace-with-openai-key
SERVICE_TOKEN=replace-with-random-service-token
# Optional at runtime; when blank, every non-empty transcript is translated.
TYPESAFE_API_KEY=
PORT=8080
IMAGE_TEXT_MODEL=gpt-4o-mini
ENCOURAGEMENT_MODEL=gpt-4o-mini
TRANSCRIPTION_MODEL=whisper-1
TRANSLATION_MODEL=gpt-4o-mini
TYPESAFE_MODEL=jev-1.13.0
IMAGE_MAX_BYTES=10485760
AUDIO_MAX_BYTES=26214400
REQUEST_BODY_MAX_BYTES=28311552
PROVIDER_TIMEOUT_MS=60000
OVERALL_TIMEOUT_MS=75000
TRANSCRIPTION_PROVIDER_TIMEOUT_MS=70000
TRANSCRIPTION_OVERALL_TIMEOUT_MS=105000
TYPESAFE_PROVIDER_TIMEOUT_MS=5000
TRANSLATION_PROVIDER_TIMEOUT_MS=25000
TRANSCRIPT_MAX_CHARS=20000
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
